# ── Backend (Vercel Functions) ──────────────────
# Set these in the Vercel Dashboard (Project → Settings → Environment Variables)
# or in a local .env.local file when running `vercel dev`.

# Claude API — required by Phase 4 (/api/coach)
ANTHROPIC_API_KEY=your_api_key_here

# Neon PostgreSQL — FUTURE (cloud sync, ROADMAP Fase 6b). There is no
# /api/sessions endpoint yet, so this variable is unused today; it is listed
# here only to reserve the slot for the Vercel/Neon integration (which injects
# it automatically once enabled).
# DATABASE_URL=postgresql://...@ep-xxx.us-east-2.aws.neon.tech/neondb

# ── Frontend ────────────────────────────────────
# Empty in production (same-origin /api). Override only for local dev against
# a non-default port or remote backend.
VITE_API_URL=
